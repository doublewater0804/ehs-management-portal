      "組長",
      "副組長"
    ],
    "reserveSupervisorProfileByUnit": {
      "龍德": "longde-manager",
      "新港": "xingang-manager"
    },
    "supervisorMatchingRule": "主管角色優先於一般職務判斷：正式主管角色對應固定主管編制並以實線表示；儲備主管依隸屬廠區對應主管編制並以虛線表示，不計入主管編制括號現有人數。職務層級僅用於統計與排序。",
    "layoutNormalization": true,
    "normalizeLayoutAlways": true,
    "layoutBoxStyle": {
      "jobWidthPt": 138,
      "jobHeightPt": 126,
      "personWidthPt": 138,
      "personHeightPt": 110,
      "supervisorWidthPt": 140,
      "supervisorHeightPt": 110,
      "rowClusterTolerancePt": 18,
      "personGapPt": 18,
      "personMinGapPt": 8,
      "connectorClearHalfWidthPt": 4,
      "minFontPt": 10,
      "fixedObstacleGapPt": 14,
      "columnCollisionPadPt": 0,
      "actualCollisionPadPt": 2,
      "localGridMinStartGapPt": 14,
      "connectorCollisionPadPt": 1.5,
      "bottomStatisticsSafetyTopPt": 1683.2,
      "bottomAnchorGapPt": 33.2
    },
    "overflowMode": "warn-only-single-page",
    "overflowMessage": "本區人員已超出目前單頁可編排容量（碰觸底部統計表），請調整編制版面。",
    "coordinateMode": "fixed-x-upper-y-local-grid-bottom-anchor-statistics-grid",
    "layoutRule": "固定組織/業務/轄區與主編制框維持骨架；動態人員固定欄中心 X、按 Local Grid Row Y；底部最後固定節點採 Bottom Anchor；分支線與人員線由 Connector Engine 唯一產生。",
    "capacityRule": "先依 Local Grid 排版；若有明確 dynamicZone，優先壓縮 Row 間距至最小值；最後固定節點受 Bottom Anchor 約束。全部排完後一次檢查底部統計安全線、框重疊與連線穿框。",
    "connectorRule": "程式接管的連線區先清除 Master 舊線，再由框幾何中心重畫；一個父框只允許一條中央主幹；有下一框才畫；多子框使用單一水平母線分支。",
    "statisticsGridRule": "底部統計依職務層級使用固定 Row Y，所有小計/合計欄對齊；某層級無值則留白。"
