    "matchingRule": "隸屬單位＋業務＋轄區定位固定編排群組；實際職務=編制目標職務為實線並計入該編制括號數，否則為虛線但仍計入整體現有人數。",
    "dynamicPersonnelLayout": true,
    "dynamicBottomLimitPt": 1655,
    "supervisorRoles": [
      "無",
      "處長",
      "工安副處長",
      "環保副處長",
      "組長",
      "副組長",
